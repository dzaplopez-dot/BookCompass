# Book Compass — Variables de entorno
# Copia este archivo como .env.local y completa los valores con las credenciales
# de tu proyecto Firebase (Consola → Configuración del proyecto → Tus apps → SDK).

# Credenciales web de Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave VAPID para Web Push (Cloud Messaging → Certificados push web)
VITE_FIREBASE_VAPID_KEY=
